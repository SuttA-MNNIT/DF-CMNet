# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# Checkpoint models (never track heavy or stale weights in git)
*.pth
*.pth.tar
**/checkpoints/*.pth
checkpoints/*.pth
Implementation/checkpoints/*.pth

# Evaluation outputs and results (generated dynamically)
Implementation/results/*.json
Implementation/results/*.png
Implementation/results/*.jpg
Implementation/results/qualitative/
results/*.json
results/*.png
results/*.jpg
results/qualitative/

# LaTeX Intermediate Auxiliary Files
*.aux
*.bbl
*.blg
*.log
*.out
*.abs
*.toc
*.synctex.gz
*.bak

# Temporary and Scratch Directories
.gemini/
scratch/
tmp/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Paper Formats and LaTeX Manuscripts (Private / Not for public repo)
Elsevier_Format/
IEEE_Format/

# Large archives (keep git repository light)
*.zip
*.tar
